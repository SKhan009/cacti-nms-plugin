[Unit]
Description=ICCT NMS Syslog retention cleanup
After=mariadb.service

[Service]
Type=oneshot
User=@WEB_USER@
Group=@WEB_GROUP@
ExecStart=/usr/bin/php @CACTI_ROOT@/plugins/icct_nms/protocols/syslog/cli/syslog_maintenance.php --days=90 --batch=5000
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
