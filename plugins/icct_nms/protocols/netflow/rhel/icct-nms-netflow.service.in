[Unit]
Description=ICCT NMS NetFlow collection and reporting importer
After=network.target mariadb.service
[Service]
Type=simple
User=apache
Group=apache
UMask=0077
ExecStart=/usr/bin/php @PLUGIN_ROOT@/protocols/netflow/cli/netflow_worker.php --follow
Restart=always
RestartSec=5
KillMode=control-group
StateDirectory=icct-nms/netflow
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/icct-nms/netflow @CACTI_LOG@
[Install]
WantedBy=multi-user.target
