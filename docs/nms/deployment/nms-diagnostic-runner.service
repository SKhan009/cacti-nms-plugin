[Unit]
Description=NMS diagnostic collector listener
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=apache
Group=apache
WorkingDirectory=/var/www/html/cacti
ExecStart=/usr/bin/php /var/www/html/cacti/plugins/nms/diagnostic_listener.php
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
