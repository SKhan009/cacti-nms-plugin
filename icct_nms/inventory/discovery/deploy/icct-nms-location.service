[Unit]
Description=ICCT GNSS position collector
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=apache
Group=apache
SupplementaryGroups=dialout
ExecStart=/usr/bin/php /var/www/html/cacti/plugins/icct_nms/dashboard/location/cli/location_worker.php
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
