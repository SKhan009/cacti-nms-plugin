{
    "format": 1,
    "php_min": "8.0.0",
    "cacti_min": "1.2.31",
    "cacti_tested": "1.2.31",
    "php_extensions": ["json", "session", "mbstring", "openssl", "pdo_mysql", "xml", "sockets"],
    "packages": {
        "rhel": [
            "php-cli",
            "php-mysqlnd",
            "php-mbstring",
            "php-xml",
            "php-snmp",
            "php-process",
            "net-snmp-utils",
            "rrdtool",
            "python3",
            "rsyslog",
            "logrotate",
            "nfdump",
            "iputils",
            "iproute",
            "net-tools",
            "traceroute",
            "mtr",
            "nmap",
            "hping3",
            "iperf3",
            "netperf",
            "chrony",
            "acl"
        ],
        "debian": [
            "php-cli",
            "php-mysql",
            "php-mbstring",
            "php-xml",
            "php-snmp",
            "snmp",
            "rrdtool",
            "python3",
            "rsyslog",
            "logrotate",
            "nfdump",
            "iputils-ping",
            "iproute2",
            "net-tools",
            "traceroute",
            "mtr-tiny",
            "nmap",
            "hping3",
            "iperf3",
            "netperf",
            "chrony",
            "acl"
        ]
    },
    "features": {
        "SNMP / MIB / LLDP / CDP": {
            "binaries": {
                "SNMP tools": ["snmpget"],
                "SNMP walk": ["snmpwalk"],
                "RRDTool": ["rrdtool"]
            },
            "services": [],
            "files": ["shared/assets/mibs/SNMPv2-SMI.txt", "protocols/snmp/mibs/js/mib-upload.js"]
        },
        "Discovery": {
            "binaries": {
                "Python": ["python3"]
            },
            "services": ["icct-nms-discovery.service"],
            "files": []
        },
        "Syslog": {
            "binaries": {
                "Receiver": ["rsyslogd"]
            },
            "services": [
                "rsyslog.service",
                "icct-nms-syslog-worker.service",
                "icct-nms-syslog-retention.timer"
            ],
            "files": [],
            "root_binaries": ["Receiver"]
        },
        "NetFlow / IPFIX": {
            "binaries": {
                "Decoder": ["nfdump"],
                "Receiver": ["nfcapd"]
            },
            "services": ["icct-nms-netflow.service"],
            "files": []
        },
        "Serial / GNSS": {
            "binaries": {
                "Python": ["python3"]
            },
            "services": ["icct-nms-location.service"],
            "files": ["protocols/serial/collector/serial_transport.py"]
        },
        "SSH": {
            "binaries": {
                "SSH terminal backend": ["guacd"]
            },
            "services": ["icct-nms-ssh.service"],
            "files": [
                "protocols/ssh/vendor/autoload.php",
                "protocols/ssh/assets/guacamole-1.6.0.js"
            ],
            "note": "Requires the bundled strict-auth patch, an HTTPS origin and a private service account. A stock guacd package alone is insufficient; see protocols/ssh/README.md."
        },
        "Diagnostics": {
            "binaries": {
                "Ping": ["ping"],
                "IP / ARP": ["ip"],
                "Traceroute": ["traceroute"],
                "MTR": ["mtr"],
                "Nping": ["nping"],
                "Hping": ["hping3", "hping"],
                "iPerf": ["iperf3"],
                "Netperf": ["netperf"],
                "Pathchar": ["pchar", "pathchar"]
            },
            "services": ["icct-nms-diagnostics.service"],
            "files": []
        },
        "Dashboard / Map": {
            "binaries": {},
            "services": [],
            "files": [
                "shared/assets/vendor/leaflet/leaflet.js",
                "shared/assets/maps/india-states.json",
                "shared/assets/fonts/ibm-plex-sans/IBMPlexSans-Regular.woff2"
            ]
        }
    },
    "pending_features": {
        "NTP monitoring": "Protocol monitoring backend is not implemented. Installing chrony supplies OS clock synchronization only; existing time sources are preserved.",
        "TACACS+": "Protocol backend is not implemented. No package installation can enable this feature yet."
    }
}
