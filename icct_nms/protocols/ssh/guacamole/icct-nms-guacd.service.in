[Unit]
Description=Apache Guacamole SSH protocol daemon for NMS
After=network.target
[Service]
Type=simple
User=icct-nms-guacd
Group=icct-nms-guacd
ExecStart=@GUACD_BINARY@ -f -b 127.0.0.1 -l @GUACD_PORT@ -L warning
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitCORE=0
TasksMax=128
MemoryMax=512M
[Install]
WantedBy=multi-user.target
