[Unit]
Description=ICCT NMS MIB simulator

[Service]
User=snmpsim
Group=snmpsim
RuntimeDirectory=icct-nms-mib-simulator
Environment=SNMP_PERSISTENT_DIR=/run/icct-nms-mib-simulator
ExecStart=/usr/sbin/snmpd -C -f -Lo -c /etc/icct-nms-mib-simulator.conf -p /run/icct-nms-mib-simulator/snmpd.pid
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
