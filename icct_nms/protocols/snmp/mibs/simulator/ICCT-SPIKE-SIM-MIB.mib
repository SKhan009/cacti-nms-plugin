ICCT-SPIKE-SIM-MIB DEFINITIONS ::= BEGIN

IMPORTS
    enterprises, MODULE-IDENTITY, OBJECT-TYPE, Integer32 FROM SNMPv2-SMI;

icctSpikeSim MODULE-IDENTITY
    LAST-UPDATED "202611160000Z"
    ORGANIZATION "ICCT NMS test fixtures"
    CONTACT-INFO "Local test fixture"
    DESCRIPTION "Synthetic readings for testing ICCT NMS graphs."
    ::= { enterprises 32473 20261116 }

icctSimulatedLevel OBJECT-TYPE
    SYNTAX Integer32 (0..100)
    MAX-ACCESS read-only
    STATUS current
    DESCRIPTION "A synthetic level that can rise and fall over time."
    ::= { icctSpikeSim 1 }

END
