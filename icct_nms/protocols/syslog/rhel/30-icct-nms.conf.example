# ICCT NMS Syslog spool integration.
# The installer generates the active file after detecting existing UDP/TCP listeners.
# This example intentionally does not stop normal rsyslog processing.

# For a manual install, copy rsyslog-template.conf to this path and apply its SELinux context.
# The automatic installer embeds the template in the managed receiver configuration.
include(file="/etc/rsyslog.d/icct-nms-template.inc")

if (($inputname == 'icct-udp') or ($inputname == 'icct-tcp') or ($inputname == 'imudp') or ($inputname == 'imtcp')) then {
  action(type="omfile"
    file="/var/log/icct-nms/remote.ndjson"
    template="ICCTNMSJson"
    fileOwner="root"
    fileGroup="apache"
    fileCreateMode="0640"
    dirCreateMode="0750"
    createDirs="on")
}
